CHAINLIT_AUTH_SECRET=

OAUTH_KEYCLOAK_CLIENT_ID=banking-ui
OAUTH_KEYCLOAK_CLIENT_SECRET=banking-ui-secret
OAUTH_KEYCLOAK_REALM=banking
OAUTH_KEYCLOAK_BASE_URL=http://localhost:8080

# Backend API (backend/main.py) and agent layer (agent/agent.py)
GEMINI_API_KEY=
THIRD_PARTY_LLM_MODEL=gemini-3.5-flash-lite
BACKEND_URL=http://localhost:8001
AUTHZ_SHARED_SECRET=

# Optional local open-weight model used as the primary reasoning backend.
# Example: Ollama or another OpenAI-compatible local server.
USE_SELF_HOSTED_LLM=false
SELF_HOSTED_LLM_BASE_URL=http://localhost:11434/v1
SELF_HOSTED_LLM_API_KEY=ollama
SELF_HOSTED_LLM_MODEL=llama3.1:8b